# Copie este arquivo para .env.benchmark.local (ignorado pelo Git) e substitua
# somente os placeholders. O nome do banco deve terminar em _benchmark.
BENCHMARK_DATABASE_URL="postgresql://BENCHMARK_USER:BENCHMARK_PASSWORD@HOST:5432/focuslist_benchmark"

# Confirmação obrigatória para comandos que podem recriar os dados do benchmark.
BENCHMARK_CONFIRMATION="FOCUSLIST_BENCHMARK_ONLY"
