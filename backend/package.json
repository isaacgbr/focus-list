{
  "name": "backend",
  "version": "1.0.0",
  "description": "",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "build:render": "npm --prefix ../frontend run build && prisma generate --config prisma7.config.ts && npm run build",
    "build:vercel": "prisma generate --config prisma7.config.ts && npm run build",
    "test:auth": "npm run build && node --test tests/auth-isolation.test.mjs",
    "test:profile": "npm run build && node --test tests/profile.test.mjs",
    "test:profile:postgres": "npm run build && node --test tests/profile-postgres.test.mjs",
    "test:demo": "npm run build && node --test tests/demo-postgres.test.mjs",
    "demo:cleanup": "tsx src/scripts/cleanup-demos.ts",
    "test:password-recovery": "npm run build && node --test --test-concurrency=1 tests/auth-password.test.mjs tests/password-recovery.test.mjs tests/password-recovery-email.test.mjs",
    "start": "node dist/server.js",
    "benchmark:check": "tsx src/benchmark/check.ts",
    "benchmark:prepare:small": "tsx src/benchmark/prepare-small.ts",
    "benchmark:seed:small": "tsx src/benchmark/seed.ts small",
    "benchmark:seed:medium": "tsx src/benchmark/seed.ts medium",
    "benchmark:seed:large": "tsx src/benchmark/seed.ts large",
    "benchmark:baseline": "tsx src/benchmark/baseline.ts",
    "benchmark:measure:small": "tsx src/benchmark/measure.ts small",
    "benchmark:measure:medium": "tsx src/benchmark/measure.ts medium",
    "benchmark:measure:large": "tsx src/benchmark/measure.ts large",
    "benchmark:concurrency": "tsx src/benchmark/concurrency.ts",
    "postinstall": "prisma skills sync || exit 0"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@vercel/functions": "3.11.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.7",
    "express": "^5.3.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "prisma": "^7.10.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  }
}
