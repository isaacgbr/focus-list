// This is your Prisma schema file
// https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Area {
  id          Int      @id @default(autoincrement())
  title       String
  description String?
  color       String?
  icon        String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  archivedAt  DateTime?

  lists       List[]
}

model List {
  id          Int      @id @default(autoincrement())
  title       String
  description String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  archivedAt  DateTime?

  areaId      Int
  area        Area     @relation(fields: [areaId], references: [id], onDelete: Cascade)

  tasks       Task[]
}

model Task {
  id           Int       @id @default(autoincrement())
  title        String
  description  String?
  dueDate      DateTime?
  priority     Priority?
  completed    Boolean   @default(false)
  completedAt  DateTime?

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  archivedAt   DateTime?

  listId       Int
  list         List      @relation(fields: [listId], references: [id], onDelete: Cascade)

  checklist    ChecklistItem[]
  links        Link[]
}

model ChecklistItem {
  id         Int       @id @default(autoincrement())
  title      String
  completed  Boolean   @default(false)

  createdAt  DateTime  @default(now())

  taskId     Int
  task       Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
}

model Link {
  id         Int       @id @default(autoincrement())
  title      String
  url        String

  createdAt  DateTime  @default(now())

  taskId     Int
  task       Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}
